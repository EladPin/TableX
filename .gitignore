# Rollback copies written by server.ps1 before a database update.
TableX/data/*.bak

# Deck templates. These are somebody's actual PowerPoint, uploaded on the
# machine they work on -- per-installation user data like the .bak above, and
# not something to carry in the repo.
TableX/data/tpl/

# Saved new-site groups (the אתרים חדשים view), written by server.ps1. The
# groups someone made on their machine, for the same reason as tpl/ above.
TableX/data/grp/

# Scratch output from tools/build_icon.py (the inline SVG snippet, which is
# pasted into index.html rather than shipped as a file).
tools/_ghost-inline.svg.txt

# Build scaffolding, if TableX is ever packaged like Interfex.
node_modules/
dist/
main.js
package.json
package-lock.json

# python bytecode from tools/*.py
__pycache__/
*.pyc

# Generated by tools/mock_idf.mjs - a throwaway import fixture, not data.
IDF_Share_MOCK.xlsx
